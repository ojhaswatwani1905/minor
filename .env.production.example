# ==============================================================================
# STSMS Production Backend Environment Variables
# Copy to cloud host environment settings (Render, Railway, Fly.io, etc.)
# ==============================================================================

NODE_ENV=production
PORT=10000

# Primary Cloud Database (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication & Cryptographic Signing
JWT_SECRET=STSMS_PRODUCTION_SUPER_SECRET_KEY_2026_SECURE_AUTH

# MoRTH Government Accident Blackspots Ingestion (Optional)
DATA_GOV_IN_API_KEY=your_production_api_key_here

