# STSMS Environment Configuration
PORT=5001

# Supabase PostgreSQL Configuration
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Alternatively:
# SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Data.gov.in API Key for MoRTH Government Accident Blackspots Ingestion
# Register at https://data.gov.in/ to get an API key
DATA_GOV_IN_API_KEY=your_api_key_here
